<Application x:Class="MinonTweaks.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MinonTweaks"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ===== ЦВЕТА (аналог :root переменных из HTML-дизайна) ===== -->
        <Color x:Key="BgColor">#FF050506</Color>
        <Color x:Key="PanelColor">#FF0D0D10</Color>
        <Color x:Key="Panel2Color">#FF13131A</Color>
        <Color x:Key="BorderColor">#FF20202A</Color>

        <Color x:Key="YellowColor">#FFFFE300</Color>
        <Color x:Key="YellowDimColor">#FFE6BE00</Color>

        <Color x:Key="TextColor">#FFF3F4F8</Color>
        <Color x:Key="MutedColor">#FF8A8A95</Color>
        <Color x:Key="Muted2Color">#FF4A4A55</Color>

        <Color x:Key="GreenColor">#FF39FF9E</Color>
        <Color x:Key="RedColor">#FFFF3B5C</Color>

        <!-- ===== КИСТИ (то, что реально используется в XAML: Background="{StaticResource ...}") ===== -->
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="Panel2Brush" Color="{StaticResource Panel2Color}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

        <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowColor}"/>
        <SolidColorBrush x:Key="YellowDimBrush" Color="{StaticResource YellowDimColor}"/>

        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
        <SolidColorBrush x:Key="Muted2Brush" Color="{StaticResource Muted2Color}"/>

        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}"/>
        <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}"/>

        <!-- ===== СТИЛЬ СКРУГЛЁННОЙ КНОПКИ ===== -->
        <!-- WPF-кнопки по умолчанию прямоугольные — свой ControlTemplate нужен для CornerRadius -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== ФОН КАРТОЧКИ ТВИКА (лёгкий градиент, как в HTML: linear-gradient(180deg, panel, #0a0a0c)) ===== -->
        <LinearGradientBrush x:Key="TweakCardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource PanelColor}" Offset="0"/>
            <GradientStop Color="#FF0A0A0C" Offset="1"/>
        </LinearGradientBrush>

        <!-- ===== КАРТОЧКА ТВИКА: подсветка жёлтым при наведении ===== -->
        <Style x:Key="TweakCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TweakCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18,16"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFFFE300" BlurRadius="26" ShadowDepth="0" Opacity="0.22"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== КНОПКА-ДЕЙСТВИЕ (ghost): для одиночных кнопок в карточках твиков ===== -->
        <Style x:Key="TweakGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource YellowBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== КНОПКА-ДЕЙСТВИЕ (primary/жёлтая): для первой из пары Применить/Откатить ===== -->
        <Style x:Key="TweakPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="{StaticResource YellowBrush}"/>
            <Setter Property="Foreground" Value="#FF111111"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FFFFE300" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== НЕОНОВЫЙ ТУМБЛЕР ===== -->
        <Style x:Key="NeonToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="12"
                                    Background="#FF1C1C1C" BorderBrush="#FF2A2A2A" BorderThickness="1"/>
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#FF555555"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbSlide" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#26FFE300"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource YellowBrush}"/>
                                <Setter TargetName="Thumb" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFFFE300" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbSlide" Storyboard.TargetProperty="X"
                                                             To="18" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbSlide" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ПОДСВЕТКА ПРИ НАВЕДЕНИИ (для карточек, у которых цвета уже заданы инлайн) ===== -->
        <Style x:Key="HoverGlowStyle" TargetType="Border">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFFFE300" BlurRadius="24" ShadowDepth="0" Opacity="0.2"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
